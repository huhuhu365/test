{
  "name": "access-request-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "银行内部 IT 权限/系统访问申请管理系统（React + Vite + json-server）",
  "scripts": {
    "dev": "vite",
    "serve": "json-server --watch db.json --port 3005",
    "start": "concurrently -k -n API,WEB -c blue,green \"pnpm serve\" \"pnpm dev\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "json-server": "0.17.4",
    "vite": "^5.4.2"
  }
}
